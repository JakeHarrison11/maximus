(require :asdf)
(let* ((args (last (si:command-args) 2))
       (root (truename (first args))))
  (asdf:load-asd (merge-pathnames "src/maxima.asd" root))
  (with-open-file (out (second args) :direction :output :if-exists :supersede)
    (dolist (action (asdf:traverse 'asdf:load-source-op (asdf:find-system :maxima)))
      (when (and (typep (car action) 'asdf:load-source-op)
                 (typep (cdr action) 'asdf:cl-source-file))
        (let ((path (enough-namestring (asdf:component-pathname (cdr action)) root)))
          (format out "/maxima/~A~%" path))))))
(quit)
