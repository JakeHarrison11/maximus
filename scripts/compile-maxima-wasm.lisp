(require :asdf)
(require :cmp)
;; The host needs macros and definitions, not native socket or package bootstrap.
(defmethod asdf:perform :around ((op asdf:load-source-op) (file asdf:cl-source-file))
  (unless (member (pathname-name (asdf:component-pathname file))
                  '("server" "defsystem") :test #'string=)
    (call-next-method)))
(let* ((args (last (si:command-args) 4))
       (root (truename (first args)))
       (target (c::read-target-info (second args)))
       (out (pathname (third args)))
       (plan-path (fourth args))
       (objects nil))
  (asdf:load-asd (merge-pathnames "src/maxima.asd" root))
  (asdf:operate 'asdf:load-source-op :maxima)
  (with-open-file (plan plan-path)
    (with-open-file (header (merge-pathnames "compiled-maxima.h" out)
                           :direction :output :if-exists :supersede)
      (format header "static int load_compiled_maxima(const char *path) {~%")
      (loop for virtual = (read-line plan nil)
            while virtual
            for relative = (subseq virtual (length "/maxima/"))
            for source = (merge-pathnames relative root)
            ;; Browser shims and unsupported formatting macros retain source loading.
            unless (member (pathname-name source)
                           '("maxima-package" "ecl-port" "server" "defsystem" "mforma" "mformt")
                           :test #'string=)
              do (let ((object (merge-pathnames
                                (make-pathname :type "o" :defaults relative) out)))
                   (ensure-directories-exist object)
                   (multiple-value-bind (file warnings failure)
                       (compile-file source :output-file object :system-p t
                                     :target target :verbose nil)
                     (declare (ignore warnings))
                     (unless (and file (not failure))
                       (error "WASM compilation failed: ~A" source)))
                   (push object objects)
                   (let ((name (c::guess-init-name object :object)))
                     (format header "  if (strcmp(path, ~S) == 0) { extern void ~A(cl_object); ecl_init_module(NULL, ~A); return 1; }~%"
                             virtual name name))))
      (format header "  return 0;~%}~%")))
  (c::compile-with-target-info
   (lambda ()
     (c::build-static-library (merge-pathnames "maxima" out)
                              :lisp-files (nreverse objects)))
   target))
(quit)
