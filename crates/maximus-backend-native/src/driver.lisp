(in-package :maxima)

(defvar *mx-out* *standard-output*)

(defun mx-escape (s)
  (with-output-to-string (o)
    (loop for c across s do
      (case c
        (#\Newline (write-string "\\n" o))
        (#\Return (write-string "\\r" o))
        (#\Tab (write-string "\\t" o))
        (#\\ (write-string "\\\\" o))
        (t (write-char c o))))))

(defun mx-unescape (s)
  (with-output-to-string (o)
    (let ((i 0) (n (length s)))
      (loop while (< i n) do
        (let ((c (char s i)))
          (if (and (char= c #\\) (< (1+ i) n))
              (progn (incf i)
                     (case (char s i)
                       (#\n (write-char #\Newline o))
                       (#\r (write-char #\Return o))
                       (#\t (write-char #\Tab o))
                       (t (write-char (char s i) o))))
              (write-char c o)))
        (incf i)))))

(defun mx-emit (id kind &rest parts)
  (format *mx-out* "@@MX~c~a~c~a" #\Tab id #\Tab kind)
  (dolist (p parts) (format *mx-out* "~c~a" #\Tab (mx-escape p)))
  (terpri *mx-out*)
  (force-output *mx-out*))

(defun mx-safe-string (x)
  (handler-case (mfuncall '$string x) (error () "?")))

(defun mx-name (sym)
  (handler-case (print-invert-case (stripdollar sym)) (error () (string-downcase (symbol-name sym)))))

;;; ---------------------------------------------------------------- plotting

(defvar *mx-id* "0")
(defparameter *mx-n2d* 400)
(defparameter *mx-n3d* 36)

(defun mx-real (v)
  (let ((f (handler-case (let ((*standard-output* (make-broadcast-stream)))
                           (mfuncall '$float v))
             (error () nil))))
    (and (realp f)
         (not (and (floatp f) (or (sb-ext:float-nan-p f) (sb-ext:float-infinity-p f))))
         (coerce f 'double-float))))

(defun mx-at (f var val)
  (handler-case
      (let ((*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream)))
        (catch 'macsyma-quit
          (mx-real ($substitute val var f))))
    (error () nil)))

(defun mx-at2 (f v1 a v2 b)
  (handler-case
      (let ((*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream)))
        (catch 'macsyma-quit
          (mx-real ($substitute b v2 ($substitute a v1 f)))))
    (error () nil)))

(defun mx-jnum (s v)
  (if v
      (let ((*read-default-float-format* 'double-float)) (format s "~a" (if (integerp v) v v)))
      (write-string "null" s)))

(defun mx-jstr (s str)
  (write-char #\" s)
  (loop for c across str do
    (case c (#\" (write-string "\\\"" s)) (#\\ (write-string "\\\\" s))
      (#\Newline (write-string "\\n" s)) (t (write-char c s))))
  (write-char #\" s))

(defun mx-range-p (x)
  (and (consp x) (eq (caar x) 'mlist) (= (length x) 4) (symbolp (cadr x))))

(defun mx-series-fn (f var lo hi n)
  (let ((pts nil) (lov (mx-real lo)) (hiv (mx-real hi)))
    (unless (and lov hiv) (merror "plot2d: the range limits must be numbers"))
    (dotimes (i (1+ n))
      (let* ((x (+ lov (* (- hiv lov) (/ i (float n 1d0)))))
             (y (mx-at f var x)))
        (push (list x y) pts)))
    (nreverse pts)))

(defun mx-emit-series (s label pts first)
  (unless first (write-char #\, s))
  (write-string "{\"label\":" s) (mx-jstr s label) (write-string ",\"pts\":[" s)
  (let ((fst t))
    (dolist (p pts)
      (unless fst (write-char #\, s))
      (setq fst nil)
      (if (and (second p) (first p))
          (progn (write-char #\[ s) (mx-jnum s (first p)) (write-char #\, s) (mx-jnum s (second p)) (write-char #\] s))
          (write-string "null" s))))
  (write-string "]}" s))

(defun mx-plot2d (args)
  (let* ((items nil) (range nil) (yrange nil))
    (dolist (a args)
      (let ((v (meval a)))
        (cond ((and (consp v) (eq (caar v) 'mlist) (member (cadr v) '($parametric $discrete)))
               (setq items (append items (list v))))
              ((and (consp v) (eq (caar v) 'mlist) (not (mx-range-p v))) (setq items (append items (cdr v))))
              ((and (mx-range-p v) (null range) items) (setq range v))
              ((and (mx-range-p v) (null range) (null items)) (setq range v))
              ((mx-range-p v) (setq yrange v))
              ((and (consp v) (eq (caar v) 'mlist)) nil)
              (t (setq items (append items (list v)))))))
    ;; an expression list given as [f,g] arrives as one mlist; a bare expression arrives alone
    (when (and (null items)) (merror "plot2d: nothing to plot"))
    (let* ((first-expr (find-if (lambda (i) (not (and (consp i) (member (cadr i) '($parametric $discrete))))) items))
           (var (cond (range (cadr range))
                      (first-expr (let ((vs (cdr (mfuncall '$listofvars first-expr)))) (if vs (car vs) '$x)))
                      (t '$x)))
           (lo (if range (caddr range) -5)) (hi (if range (cadddr range) 5))
           (json (with-output-to-string (s)
                   (write-string "{\"kind\":\"plot2d\",\"series\":[" s)
                   (let ((first t))
                     (dolist (it items)
                       (cond
                         ((and (consp it) (eq (caar it) 'mlist) (eq (cadr it) '$parametric))
                          (destructuring-bind (xe ye r) (cddr it)
                            (let* ((tv (cadr r)) (tl (mx-real (caddr r))) (th (mx-real (cadddr r))) (pts nil))
                              (unless (and tl th) (merror "plot2d: parametric range must be numeric"))
                              (dotimes (i (1+ *mx-n2d*))
                                (let ((tt (+ tl (* (- th tl) (/ i (float *mx-n2d* 1d0))))))
                                  (push (list (mx-at xe tv tt) (mx-at ye tv tt)) pts)))
                              (mx-emit-series s (mx-safe-string (list '(mlist) xe ye)) (nreverse pts) first)
                              (setq first nil))))
                         ((and (consp it) (eq (caar it) 'mlist) (eq (cadr it) '$discrete))
                          (let ((xs (cdr (caddr it))) (ys (cdr (cadddr it))))
                            (mx-emit-series s "points"
                                            (mapcar (lambda (x y) (list (mx-real x) (mx-real y))) xs ys) first)
                            (setq first nil)))
                         (t (mx-emit-series s (mx-safe-string it) (mx-series-fn it var lo hi *mx-n2d*) first)
                            (setq first nil)))))
                   (write-string "],\"xlabel\":" s) (mx-jstr s (mx-safe-string var))
                   (write-string ",\"yrange\":" s)
                   (if yrange
                       (progn (write-string "[" s) (mx-jnum s (mx-real (caddr yrange))) (write-string "," s)
                              (mx-jnum s (mx-real (cadddr yrange))) (write-string "]" s))
                       (write-string "null" s))
                   (write-string "}" s))))
      (mx-emit *mx-id* "plot" json))))

(defun mx-plot3d (args)
  (let ((f nil) (rs nil))
    (dolist (a args)
      (let ((v (meval a)))
        (cond ((mx-range-p v) (push v rs))
              ((null f) (setq f v)))))
    (setq rs (nreverse rs))
    (unless (and f (>= (length rs) 2)) (merror "plot3d: expected plot3d(expr, [x,a,b], [y,c,d])"))
    (let* ((rx (first rs)) (ry (second rs))
           (x0 (mx-real (caddr rx))) (x1 (mx-real (cadddr rx)))
           (y0 (mx-real (caddr ry))) (y1 (mx-real (cadddr ry)))
           (n *mx-n3d*)
           (json (with-output-to-string (s)
                   (write-string "{\"kind\":\"plot3d\",\"series\":[],\"xlabel\":" s) (mx-jstr s (mx-safe-string (cadr rx)))
                   (write-string ",\"ylabel\":" s) (mx-jstr s (mx-safe-string (cadr ry)))
                   (write-string ",\"grid\":{\"label\":" s) (mx-jstr s (mx-safe-string f))
                   (write-string ",\"xs\":[" s)
                   (dotimes (i (1+ n)) (when (> i 0) (write-char #\, s)) (mx-jnum s (+ x0 (* (- x1 x0) (/ i (float n 1d0))))))
                   (write-string "],\"ys\":[" s)
                   (dotimes (j (1+ n)) (when (> j 0) (write-char #\, s)) (mx-jnum s (+ y0 (* (- y1 y0) (/ j (float n 1d0))))))
                   (write-string "],\"zs\":[" s)
                   (dotimes (i (1+ n))
                     (when (> i 0) (write-char #\, s))
                     (write-char #\[ s)
                     (dotimes (j (1+ n))
                       (when (> j 0) (write-char #\, s))
                       (mx-jnum s (mx-at2 f (cadr rx) (+ x0 (* (- x1 x0) (/ i (float n 1d0))))
                                          (cadr ry) (+ y0 (* (- y1 y0) (/ j (float n 1d0)))))))
                     (write-char #\] s))
                   (write-string "]}}" s))))
      (mx-emit *mx-id* "plot" json))))

(defun mx-plot-form-p (form)
  (and (consp form) (consp (car form))
       (member (caar form) '($plot2d $wxplot2d $plot3d $wxplot3d))))

(defun mx-run-plot (form)
  (let ((name (caar form)))
    (if (member name '($plot2d $wxplot2d))
        (mx-plot2d (cdr form))
        (mx-plot3d (cdr form)))
    '$done))

(defun mx-eval-one (id form display)
  (let* ((c-tag (makelabel $inchar))
         (out (make-string-output-stream))
         (result nil) (ok nil) (errtext nil))
    (setf (symbol-value c-tag) form)
    (setq $__ form)
    (let ((*standard-output* out) (*error-output* out))
      (handler-case
          (catch 'macsyma-quit
            (setq result (if (mx-plot-form-p form) (mx-run-plot form) (meval* form)))
            (setq ok t))
        (sb-sys:interactive-interrupt () (setq errtext "Interrupted"))
        (error (e) (setq errtext (princ-to-string e)))))
    (let ((captured (get-output-stream-string out)))
      (cond
        (ok
         (when (> (length captured) 0) (mx-emit id "out" captured))
         (setq $% result)
         (let ((d-tag (makelabel $outchar)))
           (setf (symbol-value d-tag) result)
           (let ((shown (and display (not (eq result '$done)))))
             (mx-emit id "result" (mx-name d-tag)
                      (if shown "1" "0")
                      (if shown (handler-case (mfuncall '$tex1 result) (error () "")) "")
                      (if shown (handler-case (mfuncall '$string result) (error () "")) "")))))
        (t
         (mx-emit id "error" (or errtext captured "error")))))
    (incf $linenum)
    ok))

(defun mx-read (in eof)
  (let ((out (make-string-output-stream)) (r :mx-err) (errtext nil))
    (let ((*standard-output* out) (*error-output* out))
      (handler-case (catch 'macsyma-quit (setq r (mread in eof)))
        (error (e) (setq errtext (princ-to-string e)))))
    (values r (or errtext (get-output-stream-string out)))))

(defun mx-eval (id text)
  (setq *mx-id* id)
  (let ((in (make-string-input-stream text)) (eof (list nil)) (all-ok t))
    (loop
      (multiple-value-bind (r msg) (mx-read in eof)
        (cond ((eq r :mx-err) (mx-emit id "error" msg) (setq all-ok nil) (return))
              ((eq r eof) (return))
              ((not (mx-eval-one id (caddr r) (eq (caar r) 'displayinput)))
               (setq all-ok nil) (return)))))
    (mx-emit id "done" (if all-ok "ok" "err"))))

(defun mx-vars (id)
  (let ((parts nil))
    (dolist (v (cdr $values))
      (unless (member (symbol-name v) '("$%" "$__" "$_") :test #'string=)
        (push "v" parts)
        (push (mx-name v) parts)
        (push (if (boundp v) (mx-safe-string (symbol-value v)) "") parts)))
    (dolist (f (cdr $functions))
      (let ((sym (if (consp f) (caar f) f)))
        (push "f" parts)
        (push (mx-name sym) parts)
        (push (handler-case (mfuncall '$string (mfuncall '$fundef sym)) (error () "")) parts)))
    (apply #'mx-emit id "vars" (nreverse parts))
    (mx-emit id "done" "ok")))

(defun mx-loop ()
  (mx-emit "0" "ready" "")
  (loop
    (let ((line (read-line *standard-input* nil nil)))
      (when (null line) (return))
      (let* ((t1 (position #\Tab line))
             (t2 (and t1 (position #\Tab line :start (1+ t1)))))
        (when t2
          (let ((id (subseq line 0 t1))
                (cmd (subseq line (1+ t1) t2))
                (payload (subseq line (1+ t2))))
            (cond ((string= cmd "eval") (mx-eval id (mx-unescape payload)))
                  ((string= cmd "vars") (mx-vars id)))))))))
